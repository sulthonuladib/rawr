{
  "name": "rawr",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Effect monorepo rewrite of ~/Tools — pnpm foundation (Phase 0)",
  "engines": {
    "node": "^24"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.22.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "pnpm --recursive --parallel run dev",
    "check": "pnpm --recursive run check",
    "test": "pnpm --recursive run test",
    "build": "pnpm --recursive run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:"
  }
}
