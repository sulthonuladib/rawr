{
  "name": "@rawr/orderbook-crawler",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Orderbook crawler — supervised per-exchange crawling with manual start/stop",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "dev": "tsc --watch -p tsconfig.json",
    "test": "vitest run --exclude '**/dist/**'"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@rawr/coin-admin-api": "workspace:*",
    "@rawr/config": "workspace:*",
    "@rawr/domain": "workspace:*",
    "@rawr/messaging": "workspace:*",
    "@rawr/observability": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
