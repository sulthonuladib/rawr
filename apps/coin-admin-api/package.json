{
  "name": "@rawr/coin-admin-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Coin admin HTTP API (PUT/PATCH /coins/:cmcId -> tx update -> publish CoinUpdated)",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "dev": "tsc --watch -p tsconfig.json",
    "start": "node ./dist/main.js",
    "test": "vitest run --exclude '**/dist/**'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@rawr/config": "workspace:*",
    "@rawr/domain": "workspace:*",
    "@rawr/messaging": "workspace:*",
    "drizzle-orm": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "pg": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
