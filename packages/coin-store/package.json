{
  "name": "@rawr/coin-store",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Drizzle Postgres repositories (cryptocurrencies, snapshots, opportunities, chains)",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "dev": "tsc --watch -p tsconfig.json",
    "test": "vitest run --exclude '**/dist/**'"
  },
  "dependencies": {
    "@effect/sql-pg": "catalog:",
    "@rawr/domain": "workspace:*",
    "drizzle-orm": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "catalog:",
    "pg": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
